# Copy to .env (scripts/dev-up.sh does this for you, with a random password).
# Read by docker compose for interpolation and passed through to the services.

# --- Database ---
POSTGRES_PASSWORD=change-me

# --- Models (baked into the ollama image at build time; must match) ---
# Check each model's licence permits commercial redistribution before shipping.
LLM_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=bge-m3
# Must match EMBED_MODEL's output size. Changing it requires a new migration + re-index.
EMBED_DIM=1024
LLM_NUM_CTX=8192

# --- Retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
# Cosine similarity below which a chunk is treated as irrelevant.
MIN_SIMILARITY=0.35

# --- Exposure ---
# The only published port. 127.0.0.1 keeps it local to this machine.
HTTP_BIND=127.0.0.1
HTTP_PORT=8000

LOG_LEVEL=INFO
