# Copy to .env (scripts/dev-up.sh does this for you, with a random password).
# Read by docker compose for interpolation and passed through to the services.

# --- Database ---
POSTGRES_PASSWORD=change-me

# --- Models (baked into the ollama image at build time; must match) ---
# Check each model's licence permits commercial redistribution before shipping.
LLM_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=bge-m3
# Must match EMBED_MODEL's output size. Changing it requires a new migration + re-index.
EMBED_DIM=1024
LLM_NUM_CTX=8192

# --- Retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
# Cosine similarity below which a chunk is treated as irrelevant.
MIN_SIMILARITY=0.35
# Optional cross-encoder reranker, baked into the api image at build time
# (rebuild after changing). Empty disables it. See docs/eval-results.md.
RERANKER_MODEL=
# Drop chunks the reranker scores below this (empty = keep the top TOP_K).
RERANK_MIN_SCORE=

# --- OCR (scanned PDF pages and PNG/JPEG/TIFF images) ---
OCR_ENABLED=true
# Tesseract languages to read, joined with '+', e.g. eng+deu. Every one must be
# installed in the api image: build it with OCR_IMAGE_LANGUAGES="eng deu".
OCR_LANGUAGES=eng
OCR_IMAGE_LANGUAGES=eng

# --- Local accounts ---
# Minimum password length (1 or more). Any characters are allowed, including
# spaces; length is the only rule. Keep 12+ unless you accept weak passwords.
PASSWORD_MIN_LENGTH=12

# --- Directory sign-in (LDAP / Active Directory) ---
# Off by default. Local accounts keep working when it's on (keep one local
# administrator for when the directory is unreachable). Single-quote any value
# containing ( ) & { } or spaces. See README.md, "Directory sign-in".
LDAP_ENABLED=false
#LDAP_URL=ldaps://dc1.example.local
#LDAP_CA_FILE=/etc/rag/certs/ldap-ca.pem
#LDAP_BIND_DN='CN=svc-rag,OU=Service Accounts,DC=example,DC=local'
#LDAP_BIND_PASSWORD='...'
#LDAP_USER_BASE_DN='OU=Staff,DC=example,DC=local'
#LDAP_USER_FILTER='(&(objectClass=user)(sAMAccountName={username}))'
#LDAP_GROUP_BASE_DN='OU=Groups,DC=example,DC=local'
#LDAP_GROUP_FILTER='(member:1.2.840.113556.1.4.1941:={user_dn})'
#LDAP_GROUP_MAP='{"CN=Finance,OU=Groups,DC=example,DC=local": "Finance"}'
#LDAP_ADMIN_GROUP='CN=RAG Admins,OU=Groups,DC=example,DC=local'
#LDAP_REQUIRED_GROUP='CN=All Employees,OU=Groups,DC=example,DC=local'

# --- Exposure ---
# nginx is the only service with published ports. HTTP redirects to HTTPS.
# 0.0.0.0 serves the office network; 127.0.0.1 keeps it on this machine only.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Put the TLS certificate in deploy/certs/ (see deploy/certs/README.md).

LOG_LEVEL=INFO
