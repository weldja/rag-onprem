# Copy to .env (scripts/dev-up.sh does this for you, with a random password).
# Read by docker compose for interpolation and passed through to the services.

# --- Database ---
POSTGRES_PASSWORD=change-me

# --- Models (baked into the ollama image at build time; must match) ---
# Check each model's licence permits commercial redistribution before shipping.
# Answer model. Qwen3 4B (2507 instruct) is the default on every server: it
# matched the 7B in our evaluation at about twice the speed.
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Other answer models built into the release bundle's ollama image (set by the
# bundle; comma-separated, no spaces). LLM_MODEL may name any of them, then
# `docker compose up -d`; no rebuild needed. qwen2.5:7b-instruct
# gives slightly more precise citations, answers about half as fast, and needs
# an 8 GB+ GPU (12 GB+ to keep the search model on the GPU as well).
LLM_EXTRA_MODELS=qwen2.5:7b-instruct
EMBED_MODEL=bge-m3
# Must match EMBED_MODEL's output size. Changing it requires a new migration + re-index.
EMBED_DIM=1024

# --- Hardware limits (set by install.sh from the GPU's memory, on a new .env) ---
# They depend on the card, not on the model. Values for the default 4B model:
#   GPU under 6 GB   LLM_NUM_CTX=4096 LLM_MAX_TOKENS=768 EMBED_NUM_GPU=0 OLLAMA_KV_CACHE_TYPE=q8_0
#   GPU 6-8 GB       LLM_NUM_CTX=8192 LLM_MAX_TOKENS=1024 OLLAMA_KV_CACHE_TYPE=q8_0
#   GPU 8 GB+, CPU   the defaults below
# EMBED_NUM_GPU=0 runs the embedding model on the CPU so it never displaces the
# LLM on a card too small for both; otherwise Ollama swaps the two on every
# question. Unset: Ollama puts it on the GPU when it fits (6 GB+ cards).
#EMBED_NUM_GPU=0
LLM_NUM_CTX=8192
# Longest answer in tokens (about 750 words per 1000); 0 = no limit. Bounds how
# long a summary can run on a slow machine.
LLM_MAX_TOKENS=1024
# Hybrid reasoning models (plain qwen3 tags such as qwen3:1.7b) need
# LLM_THINK=false, or they write a long hidden "thinking" section first.
# Leave unset for instruct models.
#LLM_THINK=false
# Model server's prompt cache in host memory, in MiB. Off (0) by default: on a
# small machine saving it cost 0.1-1.5 s per question, and 5 s after sitting
# idle. Worth trying (e.g. 8192) on a server with many users asking about the
# same documents. Both models are also loaded when the api starts.
#LLAMA_ARG_CACHE_RAM=0

# --- Retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
# Longest part of each excerpt the model reads when answering, in characters
# (0 = whole excerpts, up to CHUNK_SIZE). The part kept is the one sharing the
# most words with the question. Off: at 500 it cut the answer out of 4 of 34
# real-document questions (docs/eval-results.md, "Prompt length").
EXCERPT_MAX_CHARS=0
# Cosine similarity below which a chunk is treated as irrelevant.
MIN_SIMILARITY=0.35
# Excerpts a document summary reads. Each one adds to the wait before the first
# word; raise it for fuller summaries on a fast GPU.
SUMMARY_CHUNKS=6
# Optional cross-encoder reranker, baked into the api image at build time
# (rebuild after changing). Empty disables it. See docs/eval-results.md.
RERANKER_MODEL=
# Drop chunks the reranker scores below this (empty = keep the top TOP_K).
RERANK_MIN_SCORE=

# --- File shares (indexed in place, read-only; up to three) ---
# Folders whose documents are indexed automatically and shown in the sidebar.
# Mount a network share on the host first (e.g. CIFS in /etc/fstab, read-only),
# then point SHARE_1_PATH at the mount point. New, changed and deleted files are
# picked up every SHARE_SCAN_INTERVAL_S seconds, or at once with "Scan now".
# Documents on a share are visible to the groups in SHARE_1_GROUPS (app group
# names, comma-separated, created if missing). Exclude folders that need other
# permissions with SHARE_1_EXCLUDE and mount them as a separate share.
# Single-quote values with spaces or backslashes (scripts read this file with bash).
# After changing these, restart: docker compose up -d
#SHARE_1_PATH=/mnt/policies
#SHARE_1_NAME='Policies'
#SHARE_1_DISPLAY_PATH='\\fileserver\policies'
#SHARE_1_GROUPS='All staff'
#SHARE_1_EXCLUDE='HR/*,Archive/*'
#SHARE_2_PATH=
#SHARE_3_PATH=
#SHARE_SCAN_INTERVAL_S=300

# --- OCR (scanned PDF pages and PNG/JPEG/TIFF images) ---
OCR_ENABLED=true
# Tesseract languages to read, joined with '+', e.g. eng+deu. Every one must be
# installed in the api image: build it with OCR_IMAGE_LANGUAGES="eng deu".
OCR_LANGUAGES=eng
OCR_IMAGE_LANGUAGES=eng

# --- GPU tuning (only used when the GPU override is enabled) ---
# Answers within 10 seconds need the whole model on the GPU ("ollama ps" shows
# "100% GPU"). Card memory kept free, in MiB: raise to 768 or 1024 if the
# ollama service crashes with out-of-memory errors.
#LLAMA_ARG_FIT_TARGET=512
# Model working memory: f16 (default) or q8_0 (half size, for a card that
# shows a CPU/GPU split). install.sh sets q8_0 on a GPU under 8 GB: on a 4 GB
# card it moved the whole model onto the GPU and doubled answer speed, with
# the same answer quality in our evaluation.
#OLLAMA_KV_CACHE_TYPE=f16

# --- Local accounts ---
# Minimum password length (1 or more). Any characters are allowed, including
# spaces; length is the only rule. Keep 12+ unless you accept weak passwords.
PASSWORD_MIN_LENGTH=12

# --- Directory sign-in (LDAP / Active Directory) ---
# Off by default. Local accounts keep working when it's on (keep one local
# administrator for when the directory is unreachable). Single-quote any value
# containing ( ) & { } or spaces. See README.md, "Directory sign-in".
LDAP_ENABLED=false
#LDAP_URL=ldaps://dc1.example.local
#LDAP_CA_FILE=/etc/rag/certs/ldap-ca.pem
#LDAP_BIND_DN='CN=svc-rag,OU=Service Accounts,DC=example,DC=local'
#LDAP_BIND_PASSWORD='...'
#LDAP_USER_BASE_DN='OU=Staff,DC=example,DC=local'
#LDAP_USER_FILTER='(&(objectClass=user)(sAMAccountName={username}))'
#LDAP_GROUP_BASE_DN='OU=Groups,DC=example,DC=local'
#LDAP_GROUP_FILTER='(member:1.2.840.113556.1.4.1941:={user_dn})'
#LDAP_GROUP_MAP='{"CN=Finance,OU=Groups,DC=example,DC=local": "Finance"}'
#LDAP_ADMIN_GROUP='CN=RAG Admins,OU=Groups,DC=example,DC=local'
#LDAP_REQUIRED_GROUP='CN=All Employees,OU=Groups,DC=example,DC=local'

# --- Exposure ---
# nginx is the only service with published ports. HTTP redirects to HTTPS.
# 0.0.0.0 serves the office network; 127.0.0.1 keeps it on this machine only.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Put the TLS certificate in deploy/certs/ (see deploy/certs/README.md).

LOG_LEVEL=INFO
