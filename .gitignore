# --- Secrets / local config ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
!deploy/nginx/**/*.example.*

# --- Python (backend) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node (frontend) ---
node_modules/
frontend/dist/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Model weights & offline bundles (large binaries, never commit) ---
/models/
*.gguf
*.safetensors
*.bin
*.onnx
*.pt
*.pth
deploy/offline-bundle/out/
*.tar
*.tar.gz
*.tgz

# --- Runtime data (Docker volumes bind-mounted in dev) ---
# Anchored to the repo root so they don't hide source dirs like deploy/ollama/.
/data/
/uploads/
/pgdata/
/ollama/
/logs/
*.log

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Evaluation reports (summaries go in docs/eval-results.md) ---
/eval-results/

# --- Claude Code local settings ---
.claude/settings.local.json
